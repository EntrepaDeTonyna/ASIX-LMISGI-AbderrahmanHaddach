/* Estils generals de tota la pàgina */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Cos principal de la web */
body {
    font-family: Arial, sans-serif;
    background-color: #f1f4f8;
    color: #263238;
    line-height: 1.6;
}

/* Contenidor per centrar el contingut */
.contenidor {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

/* Capçalera */
.capcalera {
    background-color: #142d4e;
    color: white;
    text-align: center;
    padding: 40px 20px;
}

/* Color especial de l'any */
.capcalera span {
    color: #f4b942;
}

/* Menú de navegació */
.menu {
    background-color: #203f64;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    padding: 15px;
}

/* Enllaços del menú */
.menu a {
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    font-weight: bold;
}

/* Efecte en passar el ratolí */
.menu a:hover {
    background-color: #f4b942;
    color: #142d4e;
    border-radius: 5px;
}

/* Seccions principals */
section {
    background-color: white;
    margin: 25px 0;
    padding: 25px;
    border-radius: 8px;
}

/* Títols */
h2 {
    color: #142d4e;
    margin-bottom: 15px;
}

/* Articles de notícies */
.noticia {
    background-color: #edf2f7;
    padding: 20px;
    margin: 15px 0;
    border-left: 5px solid #f4b942;
    border-radius: 5px;
}

/* Enllaços */
a {
    color: #1c65a5;
}

/* Llistes */
ul {
    margin-left: 25px;
}

/* Taules */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    border: 1px solid #ccc;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #203f64;
    color: white;
}

/* Citacions */
blockquote {
    background-color: #edf2f7;
    border-left: 5px solid #f4b942;
    padding: 20px;
    margin: 20px 0;
    font-style: italic;
}

/* Peu de pàgina */
.peu {
    background-color: #142d4e;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

/* Taules */
table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    background-color: white;
}

th {
    background-color: #142d4e;
    color: white;
}

th, td {
    padding: 12px;
    border: 1px solid #dddddd;
    text-align: left;
}

/* Citacions */
blockquote {
    background-color: #ffffff;
    border-left: 5px solid #f4b942;
    padding: 20px;
    margin: 25px 0 10px;
    font-style: italic;
}

/* Vídeo */
.video {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: 20px;
}

.video iframe {
    width: 100%;
    height: 100%;
    border: none;
}
#presentacio {
    padding: 35px 0;
}
#categories {
    margin-top: 30px;
}
