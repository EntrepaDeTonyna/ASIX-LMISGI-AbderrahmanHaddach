        <!-- Presentació del projecte -->
        <section id="inici">
            <h2>Les notícies més destacades del 2025</h2>

            <p>
                Benvinguts a Notícies 2025, un espai dedicat a recopilar
                alguns dels esdeveniments més importants de l'any.
                Trobaràs informació sobre tecnologia, esports,
                ciència i medi ambient.
            </p>
        </section>

        <hr>

        <!-- Articles amb les diferents categories -->
        <section id="destacades">

            <h2>Categories destacades</h2>

            <article class="noticia">
                <h3>Tecnologia</h3>
                <p>
                    Els avenços en intel·ligència artificial han continuat
                    transformant la societat i el món digital.
                </p>
                <a href="tecnologia.html">Llegir més</a>
            </article>

            <article class="noticia">
                <h3>Esports</h3>
                <p>
                    El món de l'esport ha viscut grans competicions
                    i moments destacats durant el 2025.
                </p>
                <a href="deportes.html">Llegir més</a>
            </article>

            <article class="noticia">
                <h3>Ciència</h3>
                <p>
                    Les missions espacials i els descobriments científics
                    han continuat ampliant els límits del coneixement.
                </p>
                <a href="ciencia.html">Llegir més</a>
            </article>

            <article class="noticia">
                <h3>Medi ambient</h3>
                <p>
                    El canvi climàtic i la protecció del planeta
                    han continuat sent temes importants.
                </p>
                <a href="medioambiente.html">Llegir més</a>
            </article>

        </section>

        <hr>

        <!-- Llista de temes tractats al web -->
        <section id="temes">
            <h2>Què trobaràs en aquesta web?</h2>

            <ul>
                <li>Notícies sobre intel·ligència artificial.</li>
                <li>Resultats i esdeveniments esportius.</li>
                <li>Descobriments científics.</li>
                <li>Informació sobre el canvi climàtic.</li>
            </ul>
        </section>

        <hr>

