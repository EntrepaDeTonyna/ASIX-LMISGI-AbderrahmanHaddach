        <section id="taula">
            <h2>Resum de les categories</h2>

            <table>
                <tr>
                    <th>Categoria</th>
                    <th>Tema principal</th>
                    <th>Any</th>
                </tr>

                <tr>
                    <td>Tecnologia</td>
                    <td>Intel·ligència artificial</td>
                    <td>2025</td>
                </tr>

                <tr>
                    <td>Esports</td>
                    <td>Competicions esportives</td>
                    <td>2025</td>
                </tr>

                <tr>
                    <td>Ciència</td>
                    <td>Exploració espacial</td>
                    <td>2025</td>
                </tr>

                <tr>
                    <td>Medi ambient</td>
                    <td>Canvi climàtic</td>
                    <td>2025</td>
                </tr>
            </table>
        </section>

