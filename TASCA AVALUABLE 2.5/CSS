
/* =================================
   ESTILOS GENERALES
================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f6f7;
    color: #222;
}

.contenidor {
    width: 85%;
    max-width: 900px;
    margin: 45px auto;
    background-color: white;
    border: 6px solid #eeeeee;
}

/* =================================
   CABECERA Y MENÚ
================================= */

header {
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.logo {
    font-size: 23px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 10px;
}

nav a {
    text-decoration: none;
    color: #222;
    font-size: 12px;
    padding: 10px 18px;
}

nav a:first-child {
    background-color: #c5effc;
}

/* =================================
   PRESENTACIÓN PRINCIPAL
================================= */

.hero {
    display: flex;
    min-height: 405px;
}

.hero-imatge {
    width: 50%;
    background-color: lightgray;
}

.hero-text {
    width: 50%;
    background-color: #c5effc;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 30px;
    text-align: center;
}

.hero-text h1 {
    font-size: 40px;
    font-weight: normal;
}

.hero-text p {
    font-size: 23px;
}

.hero-imatge img {
    width: 100%;
    height: 405px;
    object-fit: cover;
    display: block;
}

/* =================================
   BOTONES
================================= */

.boto {
    display: inline-block;
    background-color: #299ce8;
    color: white;
    text-decoration: none;
    border: none;
    border-radius: 25px;
    padding: 8px 25px;
    font-size: 16px;
    width: 175px;
    text-align: center;
    cursor: pointer;
}

/* =================================
   SECCIÓN SOBRE NOSOTROS
================================= */

.sobre-mi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    padding: 25px;
    min-height: 400px;
}

.sobre-imatge h2 {
    font-size: 30px;
    font-weight: normal;
    margin-bottom: 20px;
}

.sobre-imatge img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
}

.sobre-text {
    padding-top: 45px;
    font-size: 12px;
}

.sobre-text ol {
    margin: 25px 0 20px 25px;
}

.sobre-text .boto {
    width: 175px;
}

/* =================================
   SECCIÓN DE OFERTAS
================================= */

.ofertes {
    background-color: #c5effc;
    padding: 40px 60px;
    text-align: center;
}

.ofertes h2 {
    font-size: 30px;
    font-weight: normal;
    margin-bottom: 15px;
}

.ofertes > p {
    font-size: 11px;
    margin-bottom: 35px;
}

/* Distribución de las cuatro tarjetas */
.targetes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 55px;
    align-items: start;
    max-width: 850px;
    margin: 0 auto;
}

/* Cada tarjeta */
.oferta {
    background-color: white;
    text-align: left;
    min-width: 0;
    overflow: hidden;
}

/* Contenedor de las imágenes */
.oferta-imatge {
    width: 100%;
    height: 145px;
    overflow: hidden;
}

/* Imágenes de las ofertas */
.oferta-imatge img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 145px;
    object-fit: cover;
}

/* Texto de las ofertas */
.oferta-text {
    padding: 10px;
    font-size: 12px;
}

.oferta-text h3 {
    font-size: 12px;
    margin-bottom: 5px;
}

/* =================================
   FORMULARIO DE CONTACTO
================================= */

.contacte {
    padding: 30px 60px 80px;
}

.contacte h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

form {
    background-color: #e5e5e5;
    border-radius: 80px;
    padding: 40px 30px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}

.camp {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
}

.camp input:not([type="radio"]):not([type="checkbox"]),
.camp textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #222;
    border-radius: 4px;
    margin-bottom: 8px;
}

.camp textarea {
    height: 85px;
    resize: vertical;
}

.camp input[type="radio"],
.camp input[type="checkbox"] {
    margin-right: 6px;
}

.camp label {
    margin-bottom: 5px;
}

form button {
    grid-column: 1 / 3;
    justify-self: center;
}

/* =================================
   PIE DE PÁGINA
================================= */

footer {
    background-color: #c5effc;
    padding: 35px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
}

footer ul {
    padding-left: 18px;
    line-height: 25px;
}

.xarxes {
    font-size: 13px;
    font-weight: bold;
}
